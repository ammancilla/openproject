FROM alpine:3.20

ARG POSTING_VERSION=3.0.0-beta.1
ARG TARGETARCH

WORKDIR /tmp/posting
RUN archive="posting_${POSTING_VERSION}_linux_${TARGETARCH}.tar.gz" \
 && release="https://github.com/darrenburns/posting/releases/download/v${POSTING_VERSION}" \
 && wget -q "${release}/${archive}" "${release}/checksums.txt" \
 && grep " ${archive}$" checksums.txt | sha256sum -c - \
 && tar -xzf "${archive}" -C /usr/local/bin posting \
 && rm -rf /tmp/posting

WORKDIR /jira-software
ENTRYPOINT ["posting"]
